# For local development. Copy to .env, never commit .env.
# MODEL_PATH is relative to the working directory; absolute paths are also accepted.
MODEL_PATH=
# To enable inference, set MODEL_PATH=weights/yolo11n.pt
MODEL_DEVICE=cpu
# 0 = legacy single-model semaphore; 1/2 = dedicated thread-owned models
MODEL_POOL_WORKERS=1
MAX_QUEUE_SIZE=16
QUEUE_TIMEOUT_SECONDS=2.0
DETECTION_RATE_LIMIT=10/minute
ENABLE_INFERENCE_PROFILING=false
